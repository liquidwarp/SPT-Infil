<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ModDir>BepInEx\plugins</ModDir>
        <DynamicMapsDll Condition="'$(DynamicMapsDll)' == '' and Exists('$(SPTPath)\BepInEx\plugins\mpstark-dynamicmaps\DynamicMaps.dll')">$(SPTPath)\BepInEx\plugins\mpstark-dynamicmaps\DynamicMaps.dll</DynamicMapsDll>
        <DynamicMapsDll Condition="'$(DynamicMapsDll)' == ''">$(MSBuildThisFileDirectory)refs\DynamicMaps.dll</DynamicMapsDll>
        <MapsExpandedDll Condition="'$(MapsExpandedDll)' == '' and Exists('$(SPTPath)\BepInEx\plugins\MapsExpanded\MapsExpanded.dll')">$(SPTPath)\BepInEx\plugins\MapsExpanded\MapsExpanded.dll</MapsExpandedDll>
        <MapsExpandedDll Condition="'$(MapsExpandedDll)' == ''">$(MSBuildThisFileDirectory)..\spt-maps-expanded\Plugin\bin\Release\netstandard2.1\MapsExpanded.dll</MapsExpandedDll>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <Reference>
            <Private>false</Private>
        </Reference>
    </ItemDefinitionGroup>

    <ItemGroup>
        <Reference Include="0Harmony">
            <HintPath>$(SPTPath)\BepInEx\core\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(SPTPath)\BepInEx\core\BepInEx.dll</HintPath>
        </Reference>
        <Reference Include="Comfort">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Comfort.dll</HintPath>
        </Reference>
        <Reference Include="DynamicMaps">
            <HintPath>$(DynamicMapsDll)</HintPath>
        </Reference>
        <Reference Include="MapsExpanded">
            <HintPath>$(MapsExpandedDll)</HintPath>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
        </Reference>
        <Reference Include="Sirenix.Serialization">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Sirenix.Serialization.dll</HintPath>
        </Reference>
        <Reference Include="spt-common">
            <HintPath>$(SPTPath)\BepInEx\plugins\spt\spt-common.dll</HintPath>
        </Reference>
        <Reference Include="spt-reflection">
            <HintPath>$(SPTPath)\BepInEx\plugins\spt\spt-reflection.dll</HintPath>
        </Reference>
        <Reference Include="Unity.TextMeshPro">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Unity.TextMeshPro.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UIModule.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="RequireSPTPath" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="'$(SPTPath)' == ''" Text="Missing SPT path" />
        <Error Condition="!Exists('$(DynamicMapsDll)')" Text="DynamicMaps.dll not found (install DynamicMaps, or place it at refs\DynamicMaps.dll)" />
        <Error Condition="!Exists('$(MapsExpandedDll)')" Text="MapsExpanded.dll not found (install Maps Expanded, or build spt-maps-expanded)" />
    </Target>
</Project>
